# EduPulse Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# Never commit the real .env file into Git.

# Generate a fresh SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key

# Set DJANGO_DEBUG to True for local development only. Defaults to False.
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames/IPs
# When DJANGO_DEBUG=True and this is empty, defaults to localhost, 127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF protection
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Password used when running local demo seed scripts (for local demo data only)
DEMO_USER_PASSWORD=change-me

